<Application x:Class="CodeMeter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- TaskbarIcon must live in XAML resources so WPF fires its Loaded event and
         H.NotifyIcon registers the icon with the Windows taskbar notification API. -->
    <tb:TaskbarIcon x:Key="TrayIcon"
                    ToolTipText="Claude Code Usage"
                    PopupActivation="LeftClick"
                    MenuActivation="RightClick"/>
  </Application.Resources>
</Application>
